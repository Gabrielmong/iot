{
  "name": "@home/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/graphql/schema.graphql','dist/graphql/schema.graphql')\"",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "predev": "pnpm --filter @home/protocols build"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/schema": "^11.0.8",
    "@home/protocols": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "graphql": "^16.15.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.4.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/ws": "^8.18.2",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
