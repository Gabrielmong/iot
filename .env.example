DATABASE_URL=postgresql://postgres:password@localhost:5432/home
DATABASE_URL_TEST=postgresql://postgres:password@localhost:5432/home_test
SECRET_KEY=change-me
PORT=4000
# Server's LAN IPv4 address, used for multicast binding
LAN_ADDRESS=192.168.1.10
# PIN (4-8 digits) for the "Admin" user created on first start, when the database has no users
BOOTSTRAP_ADMIN_PIN=
# Optional: hours between background Tuya key syncs (default 6; 0 turns them off)
# TUYA_SYNC_HOURS=6
# Optional: deploy helper (docs/RUNNING.md, "Deploying automatically").
# DEPLOYER_URL defaults to http://127.0.0.1:4100.
# DEPLOYER_TOKEN_FILE is set by the service on each deploy; when unset, the Deploys page says the helper isn't running.
# DEPLOYER_URL=http://127.0.0.1:4100
# DEPLOYER_TOKEN_FILE=C:\HomeControl\deployer\api-token
